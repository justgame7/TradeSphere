<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches --bg (#0b0e17) in the web app's CSS, so the native window,
         status bar, and navigation bar never show a mismatched color. -->
    <color name="appBackground">#0b0e17</color>
    <color name="colorPrimary">#0b0e17</color>
    <color name="colorPrimaryDark">#0b0e17</color>
    <color name="colorAccent">#35e0c0</color>
</resources>
